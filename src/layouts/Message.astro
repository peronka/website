---
// Short one-off status pages (signup confirmations). Not indexed.
import { ArrowLeft } from '@lucide/astro';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  kicker: string;
  title: string;
  lead: string;
}

const { kicker, title, lead } = Astro.props;
---

<Base title={title} noindex>
  <Nav tone="light" />
  <main class="wrap message" id="tresc">
    <p class="message__kicker mono">{kicker}</p>
    <h1 class="message__title">{title}</h1>
    <p class="message__lead">{lead}</p>
    <a class="message__link" href="/"><ArrowLeft size={18} aria-hidden="true" /> Wróć na stronę główną</a>
  </main>
  <Footer />
</Base>

<style>
  .message {
    display: grid;
    justify-items: start;
    gap: 20px;
    padding-top: clamp(72px, 12vw, 160px);
    padding-bottom: clamp(72px, 12vw, 160px);
  }

  .message__kicker {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--amber);
  }

  .message__title {
    max-width: 14ch;
    font-size: clamp(2.4rem, 1.8rem + 2.6vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .message__lead {
    max-width: 52ch;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .message__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    font-weight: 700;
    text-decoration: none;
  }
</style>

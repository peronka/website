---
import { site } from '../config';

interface Props {
  size?: 'small' | 'large';
  tone?: 'light' | 'dark';
}

const { size = 'large', tone = 'light' } = Astro.props;
const url = site.appStoreUrl;
const Tag = url ? 'a' : 'span';
// Until the listing is live there is nothing to link to, so the button
// says so instead of pointing at a dead URL.
const small = url ? 'Pobierz z' : 'Wkrótce w';
---

<Tag
  class:list={['store', `store--${size}`, `store--${tone}`, { 'store--soon': !url }]}
  href={url || undefined}
  rel={url ? 'noopener' : undefined}
>
  {
    size === 'small' ? (
      <span class="store__single">{url ? 'Pobierz' : 'Wkrótce w App Store'}</span>
    ) : (
      <span class="store__label">
        <span class="store__small">{small}</span>
        <span class="store__big">App Store</span>
      </span>
    )
  }
</Tag>

<style>
  .store {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s,
      box-shadow 0.15s;
  }

  .store--light {
    background: var(--white);
    color: var(--night);
  }

  .store--dark {
    background: var(--navy);
    color: var(--white);
  }

  .store--small {
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .store--large {
    padding: 12px 24px;
    border-radius: 14px;
  }

  .store__label {
    display: grid;
    line-height: 1.15;
  }

  .store__small {
    font-size: 0.75rem;
    font-weight: 500;
    opacity: 0.72;
  }

  .store__big {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  a.store:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgb(11 26 64 / 0.25);
  }

  .store--soon {
    cursor: default;
  }
</style>

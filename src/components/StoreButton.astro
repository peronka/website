---
import { site } from '../config';
// Official Polish badge from Apple Marketing Tools ("Pobierz w App Store").
// Apple's guidelines forbid recoloring it or adding effects, so it is shown as is.
import badge from '../assets/brand/app-store-badge-pl.svg';

interface Props {
  size?: 'small' | 'large';
  tone?: 'light' | 'dark';
}

const { size = 'large', tone = 'light' } = Astro.props;
const url = site.appStoreUrl;
// Until the listing is live there is nothing to download, so the button
// leads to the "Powiadom mnie" form in the CTA band instead.
const href = url || '/#pobierz';
---

{
  url && size === 'large' ? (
    <a class="badge" href={url} rel="noopener">
      <img src={badge.src} width={badge.width} height={badge.height} alt="Pobierz w App Store" />
    </a>
  ) : (
    <a class:list={['store', `store--${size}`, `store--${tone}`]} href={href} rel={url ? 'noopener' : undefined}>
      {size === 'small' ? (
        <span class="store__single">{url ? 'Pobierz' : 'Powiadom mnie'}</span>
      ) : (
        <span class="store__label">
          <span class="store__small">Wkrótce w App Store</span>
          <span class="store__big">Powiadom mnie</span>
        </span>
      )}
    </a>
  )
}

<style>
  .store {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 0.15s,
      box-shadow 0.15s;
  }

  .store--light {
    background: var(--white);
    color: var(--night);
  }

  .store--dark {
    background: var(--navy);
    color: var(--white);
  }

  .store--small {
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .store--large {
    padding: 12px 24px;
    border-radius: 14px;
  }

  .store__label {
    display: grid;
    line-height: 1.15;
  }

  .store__small {
    font-size: 0.75rem;
    font-weight: 500;
    opacity: 0.72;
  }

  .store__big {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .store:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgb(11 26 64 / 0.25);
  }

  /* Height above Apple's 40px on-screen minimum; clear space comes from the parent gaps. */
  .badge {
    display: inline-block;
    border-radius: 9px;
  }

  .badge img {
    display: block;
    width: auto;
    height: 56px;
  }
</style>

---
import { site } from '../config';
import { isEnglish, localizedPath } from '../lib/i18n';

interface Props {
  id: string;
  androidTests?: boolean;
  useMailClient?: boolean;
}

const { id, androidTests = false, useMailClient = false } = Astro.props;
const en = isEnglish(Astro.url.pathname);
const endpoint = androidTests ? '/api/testy-android/' : '/api/powiadom/';
const action = useMailClient ? `mailto:${site.emails.main}` : en ? `${endpoint}?lang=en` : endpoint;
const copy = en ? {
  subject: 'Application for the Peronka closed test on Android',
  label: androidTests ? 'Google Play account email address' : 'Coming soon to the App Store. Enter your email to hear when Peronka launches.',
  button: useMailClient ? 'Open email draft' : androidTests ? 'Apply to test' : 'Notify me',
  note: androidTests
    ? 'By applying, you agree that we can use this email address to invite you to the test on Google Play.'
    : 'We’ll send one email when Peronka launches. Confirm your signup using the link in your email. You can withdraw your consent at any time.',
  success: androidTests
    ? 'Thank you! The Peronka team has received your application.'
    : 'Check your inbox and follow the link to confirm your signup.',
} : {
  subject: 'Zgłoszenie do zamkniętych testów Peronki na Androidzie',
  label: androidTests ? 'Adres e-mail konta Google Play' : 'Wkrótce w App Store. Zostaw e-mail — damy znać w dniu premiery.',
  button: useMailClient ? 'Otwórz e-mail ze zgłoszeniem' : androidTests ? 'Zgłoś się do testów' : 'Powiadom mnie',
  note: androidTests
    ? 'Wysyłając zgłoszenie, zgadzasz się na użycie tego adresu do zaproszenia Cię do testów w Google Play.'
    : 'Wyślemy jedną wiadomość o udostępnieniu Peronki. Zapis potwierdzasz linkiem z maila, a zgodę możesz wycofać w każdej chwili.',
  success: androidTests
    ? 'Dziękujemy! Twoje zgłoszenie trafiło do zespołu Peronki.'
    : 'Prawie gotowe — potwierdź zapis, klikając link w wiadomości, którą właśnie wysłaliśmy.',
};
---

<form class="notify" action={action} method={useMailClient ? 'get' : 'post'} data-success={copy.success}>
  {useMailClient && <input type="hidden" name="subject" value={copy.subject} />}
  <label class="notify__label" for={id}>
    {copy.label}
  </label>
  <div class="notify__row">
    <input
      class="notify__input"
      id={id}
      type="email"
      name={useMailClient ? 'body' : 'email'}
      required
      maxlength="254"
      autocomplete="email"
      placeholder={en ? 'you@example.com' : 'twoj@adres.pl'}
    />
    <button class="notify__button" type="submit">{copy.button}</button>
  </div>
  {!useMailClient && <div class="notify__hp" aria-hidden="true">
    <label>{en ? 'Website' : 'Strona internetowa'} <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>}
  <p class="notify__note">
    {copy.note}
    <a href={localizedPath('/polityka-prywatnosci/', en)}>{en ? 'Privacy policy' : 'Polityka prywatności'}</a>
  </p>
  <p class="notify__status" role="status" aria-live="polite"></p>
</form>

<script>
  const en = document.documentElement.lang === 'en';
  for (const form of document.querySelectorAll<HTMLFormElement>('.notify')) {
    const button = form.querySelector('button')!;
    const status = form.querySelector<HTMLElement>('.notify__status')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.action.startsWith('mailto:')) {
        const data = new FormData(form);
        const subject = encodeURIComponent(String(data.get('subject')));
        const intro = en ? 'I would like to join the test. My Google Play account email is' : 'Chcę dołączyć do testów. Mój adres konta Google Play:';
        const body = encodeURIComponent(`${intro} ${data.get('body')}`);
        window.location.href = `${form.action}?subject=${subject}&body=${body}`;
        status.textContent = en ? 'Send the draft from your email app to submit your application.' : 'Wyślij przygotowaną wiadomość w swojej aplikacji pocztowej.';
        return;
      }
      button.disabled = true;
      form.dataset.state = 'sending';
      status.textContent = en ? 'Submitting…' : 'Zapisuję…';

      let error = en ? 'We couldn’t submit your signup. Please try again shortly.' : 'Nie udało się zapisać. Spróbuj ponownie za chwilę.';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.dataset.state = 'done';
          status.textContent = form.dataset.success!;
          form.reset();
          return;
        }
        const data: { error?: string } = await res.json().catch(() => ({}));
        error = data.error ?? error;
      } catch {
        // Network failure: keep the generic message.
      }

      form.dataset.state = 'error';
      status.textContent = error;
      button.disabled = false;
    });
  }
</script>

<style>
  .notify {
    display: grid;
    gap: 12px;
    inline-size: 440px;
    max-inline-size: 100%;
    min-inline-size: 0;
  }

  .notify__label {
    font-weight: 600;
    line-height: 1.4;
  }

  .notify__row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .notify__input {
    flex: 1 1 220px;
    min-width: 0;
    padding: 14px 16px;
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: 14px;
    background: rgb(255 255 255 / 0.08);
    color: var(--white);
    font: inherit;
  }

  .notify__input::placeholder {
    color: var(--mist-2);
  }

  .notify__button {
    padding: 14px 22px;
    border: 0;
    border-radius: 14px;
    background: var(--white);
    color: var(--night);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition:
      transform 0.15s,
      box-shadow 0.15s;
  }

  .notify__button:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgb(11 26 64 / 0.25);
  }

  .notify__button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .notify__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .notify__note {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--mist-2);
  }

  .notify__note a {
    color: var(--mist);
  }

  .notify__status {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--mist);
  }

  .notify__status:empty {
    display: none;
  }

  .notify[data-state='error'] .notify__status {
    color: var(--amber-bright);
  }

  .notify[data-state='done'] .notify__label,
  .notify[data-state='done'] .notify__row,
  .notify[data-state='done'] .notify__note {
    display: none;
  }
</style>

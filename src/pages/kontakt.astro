---
import { MessageCircle, Bug, Lightbulb, ShieldCheck, ArrowUpRight, ArrowRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';

const channels = [
  { icon: MessageCircle, title: 'Pytania ogólne', text: 'Pytania o aplikację, współpraca i reklamacje.', email: site.emails.main },
  { icon: Bug, title: 'Zgłoś błąd', text: 'Opisz, co się stało, i podaj model telefonu oraz wersję aplikacji.', email: site.emails.bugs },
  { icon: Lightbulb, title: 'Pomysł na funkcję', text: 'Napisz, czego brakuje Ci w Peronce — czytamy każdą wiadomość.', email: site.emails.feedback },
  { icon: ShieldCheck, title: 'Prywatność i dane', text: 'Wnioski z RODO: dostęp do danych, usunięcie, sprzeciw.', email: site.emails.privacy },
];

const times = [
  { label: 'Zwykle', value: 'do 24 h w dni robocze' },
  { label: 'Reklamacje', value: 'do 14 dni roboczych' },
  { label: 'Sprawy RODO', value: 'do 30 dni' },
];
---

<Base title="Kontakt" description="Napisz do zespołu Peronki: pytania, zgłoszenia błędów, pomysły na funkcje i sprawy RODO.">
  <Nav tone="light" />
  <main>
    <PageHeader
      kicker="Kontakt"
      title="Napisz do nas"
      intro="Masz pytanie, znalazłeś błąd albo brakuje Ci jakiejś funkcji? Wybierz temat — wiadomość trafi prosto do właściwej skrzynki."
    />

    <div class="wrap contact">
      <ul class="channels">
        {
          channels.map((c) => (
            <li class="channel">
              <span class="channel__icon">
                <c.icon size={24} aria-hidden="true" />
              </span>
              <div class="channel__text">
                <h2 class="channel__title">{c.title}</h2>
                <p class="channel__desc">{c.text}</p>
              </div>
              <a class="channel__email" href={`mailto:${c.email}`}>
                {c.email}
                <ArrowUpRight size={18} aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>

      <aside class="aside">
        <div>
          <h2 class="aside__heading mono">Czas odpowiedzi</h2>
          <dl class="times">
            {
              times.map((t) => (
                <div class="times__row">
                  <dt>{t.label}</dt>
                  <dd>{t.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="status-box">
          <p class="status-box__kicker mono"><span class="live-dot" aria-hidden="true"></span>Coś nie działa?</p>
          <p class="status-box__title">Sprawdź status usług, zanim napiszesz</p>
          <p class="status-box__text">
            Jeśli dane z PKP PLK chwilowo nie docierają, zobaczysz to od razu na stronie statusu.
          </p>
          <a class="status-box__link" href="/status/">Status usług <ArrowRight size={18} aria-hidden="true" /></a>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 96px;
    padding-top: 72px;
    padding-bottom: var(--section);
  }

  .channels {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channel {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }

  .channel:last-child {
    border-bottom: 1px solid var(--line);
  }

  .channel__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: #eef2f8;
    color: var(--navy);
  }

  .channel__text {
    display: grid;
    gap: 6px;
  }

  .channel__title {
    font-size: 1.3125rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .channel__desc {
    color: var(--ink-2);
    line-height: 1.5;
  }

  .channel__email {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--link);
    text-decoration: none;
  }

  .channel__email:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .aside {
    display: grid;
    align-content: start;
    gap: 24px;
  }

  .aside__heading {
    padding-top: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink-3);
  }

  .times {
    margin: 0;
  }

  .times__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .times dt {
    color: var(--ink-2);
  }

  .times dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  .status-box {
    display: grid;
    gap: 12px;
    padding: 28px;
    border-radius: 20px;
    background: var(--navy);
    color: var(--white);
  }

  .status-box__kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--mist);
  }

  .status-box__title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .status-box__text {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--mist);
  }

  .status-box__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-top: 6px;
    font-weight: 700;
    text-decoration: none;
  }

  .status-box__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 960px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      padding-top: 40px;
    }
  }

  @media (max-width: 640px) {
    .channel {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 12px 16px;
      padding: 24px 0;
    }

    .channel__icon {
      width: 44px;
      height: 44px;
    }

    .channel__email {
      grid-column: 2;
      font-size: 1rem;
    }
  }
</style>

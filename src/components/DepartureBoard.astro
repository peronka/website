---
import { RefreshCw } from '@lucide/astro';
import { START, fmt, initial, view } from '../lib/departures';

const [hh, mm] = fmt(START).split(':');
const rows = initial.map((d) => ({ d, v: view(d, START) }));
---

<figure class="board-wrap">
  <div class="board" role="table" aria-label="Przykładowa tablica odjazdów: Warszawa Centralna">
    <div class="board__head" role="rowgroup">
      <div role="row" class="board__head-row">
        <div role="columnheader">
          <p class="board__station">Warszawa Centralna</p>
          <p class="board__kind">Odjazdy</p>
        </div>
        <p class="board__clock mono" role="columnheader">
          <span class="board__hh">{hh}</span><span class="board__colon">:</span><span class="board__mm">{mm}</span>
        </p>
      </div>
    </div>
    <div class="board__body" role="rowgroup">
      {
        rows.map(({ d, v }, i) => (
          <div role="row" class:list={['board__row', { 'board__row--flash': i === 1 }]} data-id={d.id}>
            <div role="cell" class="board__time mono">
              <span class:list={['board__time-value', { 'board__time--late': d.delay > 0 }]}>{v.time}</span>
              <s class="board__planned" hidden={!v.planned}>
                <span class="sr-only">planowo </span>
                <span class="board__planned-value">{v.planned}</span>
              </s>
            </div>
            <div role="cell" class="board__mid">
              <p class="board__line">
                <span class="board__train mono" style={`background:${d.color}`}>
                  {d.train}
                </span>
                <span class="board__dest">{d.dest}</span>
              </p>
              <p class="board__via">{d.via}</p>
            </div>
            <div role="cell" class="board__platform mono">{v.platform}</div>
            <div role="cell" class="board__status">
              <span class:list={['board__pill', `board__pill--${v.state}`]}>{v.status}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <figcaption class="board-caption mono">
    <RefreshCw size={14} aria-hidden="true" />
    Tak wygląda tablica w aplikacji — godziny, perony i opóźnienia na bieżąco.
  </figcaption>
</figure>

<script>
  import { fmt, view, type Departure } from '../lib/departures';
  import { AMBER, BLUE, flip, highlight, motionOk, slide, spin } from '../lib/motion';
  import { subscribe, type Frame } from '../lib/station-sim';

  const board = document.querySelector<HTMLElement>('.board');
  if (board && motionOk) live(board);

  function live(board: HTMLElement) {
    const body = board.querySelector<HTMLElement>('.board__body')!;
    const hh = board.querySelector<HTMLElement>('.board__hh')!;
    const mm = board.querySelector<HTMLElement>('.board__mm')!;
    const icon = board.parentElement?.querySelector('.board-caption svg');
    const narrow = matchMedia('(max-width: 560px)');
    // Server-rendered rows carry the ids of the initial departures.
    const rows = new Map<number, HTMLElement>();
    for (const row of body.querySelectorAll<HTMLElement>('.board__row')) rows.set(Number(row.dataset.id), row);

    function paint(row: HTMLElement, d: Departure, now: number, animated: boolean) {
      const v = view(d, now);
      const $ = (selector: string) => row.querySelector<HTMLElement>(selector)!;
      const time = $('.board__time-value');
      flip(time, v.time, animated);
      time.classList.toggle('board__time--late', d.delay > 0);
      $('.board__planned').hidden = !v.planned;
      $('.board__planned-value').textContent = v.planned;
      const train = $('.board__train');
      train.textContent = d.train;
      train.style.background = d.color;
      $('.board__dest').textContent = d.dest;
      $('.board__via').textContent = d.via;
      flip($('.board__platform'), v.platform, animated);
      const pill = $('.board__pill');
      pill.classList.remove('board__pill--ok', 'board__pill--late', 'board__pill--in');
      pill.classList.add(`board__pill--${v.state}`);
      flip(pill, v.status, animated);
    }

    // Narrow screens show four rows (see the CSS), wider ones five.
    function render({ now, trains, changes }: Frame, animated: boolean) {
      const shown = trains.slice(0, narrow.matches ? 4 : 5);
      const ids = new Set(shown.map((d) => d.id));
      for (const [id, row] of rows) {
        if (ids.has(id)) continue;
        rows.delete(id);
        if (animated) slide(row, 'out');
        else row.remove();
      }
      for (const d of shown) {
        const row = rows.get(d.id);
        if (row) {
          paint(row, d, now, animated);
          continue;
        }
        // Cloning a rendered row keeps Astro's scoped-style attributes.
        const added = body.querySelector('.board__row')!.cloneNode(true) as HTMLElement;
        added.removeAttribute('style');
        added.classList.remove('board__row--flash');
        paint(added, d, now, false);
        body.append(added);
        rows.set(d.id, added);
        if (animated) slide(added, 'in');
      }
      if (!animated) return;
      for (const { kind, id } of changes) {
        const row = rows.get(id);
        if (row) highlight(row, kind === 'delay' ? AMBER : BLUE);
      }
    }

    let frame = subscribe(board, (next) => {
      frame = next;
      const [h, m] = fmt(next.now).split(':');
      flip(hh, h);
      flip(mm, m);
      spin(icon);
      render(next, true);
    });
    board.classList.add('board--live');
    render(frame, false);
    narrow.addEventListener('change', () => render(frame, false));
  }
</script>

<style>
  .board-wrap {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .board {
    overflow: hidden;
    background: var(--navy);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 20px;
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.33);
    color: var(--white);
  }

  .board__head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    background: var(--navy-2);
  }

  .board__station {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .board__kind {
    font-size: 0.875rem;
    color: var(--mist);
  }

  .board__clock {
    font-size: 1.75rem;
    font-weight: 700;
  }

  .board__hh,
  .board__mm {
    display: inline-block;
  }

  .board--live .board__colon {
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0.25; }
  }

  .board__row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto 96px;
    gap: 18px;
    align-items: center;
    padding: 18px 24px;
  }

  .board__row + .board__row {
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  .board__time {
    display: grid;
    gap: 2px;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .board__time--late {
    color: var(--amber-bright);
  }

  .board__planned {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--mist-2);
  }

  .board__mid {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .board__line {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .board__train {
    flex: none;
    padding: 2px 7px;
    border-radius: 5px;
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .board__dest {
    overflow: hidden;
    font-size: 1.125rem;
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .board__via {
    font-size: 0.8125rem;
    color: var(--mist-2);
  }

  .board__platform {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--mist);
  }

  .board__status {
    display: flex;
    justify-content: flex-end;
  }

  .board__pill {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .board__pill--ok { background: rgb(22 163 74 / 0.18); color: #86efac; }
  .board__pill--late { background: rgb(245 158 11 / 0.18); color: #fcd34d; }
  .board__pill--in { background: rgb(59 130 246 / 0.18); color: #93c5fd; }

  /* The delayed train lights up once on load; the script adds the rest of the motion. */
  .board__row--flash {
    background: rgb(245 158 11 / 0.08);
    animation: flash 1.6s 0.9s ease-out both;
  }

  @keyframes flash {
    0% { background: rgb(245 158 11 / 0); }
    35% { background: rgb(245 158 11 / 0.28); }
    100% { background: rgb(245 158 11 / 0.08); }
  }

  .board-caption {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-inline: 4px;
    font-size: 0.8125rem;
    color: var(--mist-2);
  }

  @media (max-width: 560px) {
    .board__head-row {
      padding: 14px 16px;
    }

    .board__station {
      font-size: 1rem;
    }

    .board__clock {
      font-size: 1.25rem;
    }

    .board__row {
      grid-template-columns: 54px minmax(0, 1fr) auto;
      grid-template-areas:
        'time mid status'
        'time mid platform';
      gap: 4px 12px;
      padding: 14px 16px;
    }

    .board__time { grid-area: time; font-size: 1.125rem; }
    .board__mid { grid-area: mid; }
    .board__status { grid-area: status; }
    .board__platform { grid-area: platform; justify-self: end; font-size: 0.6875rem; }
    .board__via { display: none; }

    .board__line {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .board__dest {
      font-size: 0.9375rem;
    }

    /* Without JS, CSS trims to four rows; the live board keeps four itself so
       rows sliding in and out stay visible. */
    .board:not(.board--live) .board__row:nth-child(n + 5) {
      display: none;
    }
  }
</style>

---
import { isEnglish } from '../lib/i18n';
import { RefreshCw } from '@lucide/astro';

const en = isEnglish(Astro.url.pathname);
import { site } from '../config';
---

<section class="board-wrap" aria-labelledby="departure-station" data-departure-board={site.apiBase}>
  <div class="board">
    <header class="board__head">
      <div>
        <h2 class="board__station" id="departure-station">Warszawa Centralna</h2>
        <p class="board__kind">{en ? 'Next departures' : 'Najbliższe odjazdy'}</p>
      </div>
      <span class="board__live mono" data-live hidden><span class="live-dot" aria-hidden="true"></span>{en ? 'Live' : 'Na żywo'}</span>
    </header>
    <p class="board__message" data-message role="status">{en ? 'Enable JavaScript to see departures.' : 'Włącz JavaScript, aby zobaczyć odjazdy.'}</p>
    <ul class="board__body" data-rows hidden></ul>
  </div>
  <p class="board-caption mono">
    <RefreshCw size={14} aria-hidden="true" />
    <span><span data-caption role="status">{en ? 'Data from PKP PLK' : 'Dane PKP PLK'}</span><span data-checked></span></span>
  </p>
  <template data-row>
    <li class="board__row">
      <div class="board__time mono">
        <time data-time></time>
        <span class="board__planned" data-planned hidden>
          <span class="sr-only">{en ? 'Scheduled' : 'Planowo'} </span><s data-planned-time></s>
        </span>
      </div>
      <div class="board__train">
        <span class="board__direction" data-direction></span>
        <span class="board__number mono" data-number></span>
      </div>
      <div class="board__platform mono" data-platform></div>
      <span class="board__pill" data-delay></span>
    </li>
  </template>
</section>

<script>
  interface Departure {
    time?: string;
    plannedTime?: string;
    trainNumber: string;
    trainName?: string;
    direction?: string;
    platform?: string;
    track?: string;
    delay: number | null;
    offline?: boolean;
  }

  interface Operations {
    departures: Departure[] | null;
  }

  const en = document.documentElement.lang === 'en';
  const locale = en ? 'en-GB' : 'pl-PL';
  const refreshMs = 60_000;
  const maxSnapshotAge = 5 * 60_000;
  const lookAheadMs = 5 * 60 * 60_000;
  const warsawTime = new Intl.DateTimeFormat(locale, {
    timeZone: 'Europe/Warsaw',
    hour: '2-digit',
    minute: '2-digit',
    hourCycle: 'h23',
  });
  const warsawDate = new Intl.DateTimeFormat(locale, { timeZone: 'Europe/Warsaw' });
  const board = document.querySelector<HTMLElement>('[data-departure-board]');

  if (board) startBoard(board);

  function startBoard(board: HTMLElement) {
    const url = `${board.dataset.departureBoard?.replace(/\/+$/, '')}/api/operations?station=33605`;
    const list = board.querySelector<HTMLUListElement>('[data-rows]')!;
    const template = board.querySelector<HTMLTemplateElement>('[data-row]')!;
    const message = board.querySelector<HTMLElement>('[data-message]')!;
    const caption = board.querySelector<HTMLElement>('[data-caption]')!;
    const checked = board.querySelector<HTMLElement>('[data-checked]')!;
    const live = board.querySelector<HTMLElement>('[data-live]')!;
    let snapshot: { departures: Departure[]; receivedAt: Date; offline: boolean } | undefined;
    let pending = false;

    function render(now: Date, failed: boolean) {
      const usable = snapshot
        && +now - +snapshot.receivedAt <= maxSnapshotAge
        && warsawDate.format(now) === warsawDate.format(snapshot.receivedAt)
        ? snapshot
        : undefined;
      const clock = warsawTime.format(now);
      // The API supplies today's Warsaw times as HH:MM and orders by departure.
      // Apply its five-hour window as cached responses can span midnight.
      const latest = new Date(+now + lookAheadMs);
      const end = warsawDate.format(now) === warsawDate.format(latest) ? warsawTime.format(latest) : '23:59';
      const departures = usable?.departures
        .filter((train): train is Departure & { time: string } => Boolean(train.time && train.time >= clock && train.time <= end))
        .slice(0, 5) ?? [];

      list.replaceChildren(...departures.map((train) => {
        const row = template.content.cloneNode(true) as DocumentFragment;
        const time = row.querySelector<HTMLTimeElement>('[data-time]')!;
        time.textContent = time.dateTime = train.time;
        const delayed = train.delay !== null && train.delay > 0;
        time.classList.toggle('board__time--late', delayed);
        if (train.plannedTime && train.plannedTime !== train.time) {
          row.querySelector<HTMLElement>('[data-planned]')!.hidden = false;
          row.querySelector<HTMLElement>('[data-planned-time]')!.textContent = train.plannedTime;
        }
        row.querySelector<HTMLElement>('[data-direction]')!.textContent = train.direction || (en ? 'Unknown destination' : 'Kierunek nieznany');
        row.querySelector<HTMLElement>('[data-number]')!.textContent = [train.trainNumber, train.trainName].filter(Boolean).join(' · ');
        row.querySelector<HTMLElement>('[data-platform]')!.textContent = [
          train.platform ? `${en ? 'Platform' : 'Peron'} ${train.platform}` : '',
          train.track ? `${en ? 'track' : 'tor'} ${train.track}` : '',
        ].filter(Boolean).join(' · ') || '—';
        const status = row.querySelector<HTMLElement>('[data-delay]')!;
        status.textContent = delayed ? `+${train.delay} min` : train.delay === null ? (en ? 'Scheduled' : 'Rozkład') : (en ? 'On time' : 'Planowo');
        status.classList.toggle('board__pill--late', delayed);
        status.classList.toggle('board__pill--ok', train.delay === 0 && !failed && !usable?.offline);
        return row;
      }));

      list.hidden = departures.length === 0;
      message.hidden = !list.hidden;
      const isLive = usable && !usable.offline && !failed;
      message.textContent = isLive
        ? (en ? 'No upcoming departures.' : 'Brak najbliższych odjazdów.')
        : (en ? 'Departures are temporarily unavailable.' : 'Odjazdy są chwilowo niedostępne.');
      live.hidden = !isLive;

      let details = en ? 'Data from PKP PLK' : 'Dane PKP PLK';
      if (failed) {
        details = departures.length
          ? (en ? 'Last data before the connection was lost' : 'Dane sprzed utraty połączenia')
          : (en ? 'Could not refresh the board' : 'Nie udało się odświeżyć tablicy');
      } else if (usable?.offline) {
        details = en ? 'Live data unavailable · timetable and last known delays' : 'Brak danych na żywo · rozkład i ostatnie znane opóźnienia';
      }
      if (caption.textContent !== details) caption.textContent = details;
      checked.textContent = usable ? ` · ${en ? 'checked at' : 'sprawdzono o'} ${warsawTime.format(usable.receivedAt)}` : '';
    }

    async function refresh() {
      if (pending || document.hidden) return;
      pending = true;
      try {
        const response = await fetch(url, { cache: 'no-store', signal: AbortSignal.timeout(12_000) });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const body: Operations = await response.json();
        if (!Array.isArray(body.departures) && body.departures !== null) {
          throw new Error('Invalid departures response');
        }
        const departures = body.departures ?? [];
        const receivedAt = new Date();
        const offline = response.headers.get('X-PKP-Status') === 'down' || departures.some((train) => train.offline);
        snapshot = { departures, receivedAt, offline };
        render(receivedAt, false);
      } catch {
        render(new Date(), true);
      } finally {
        pending = false;
      }
    }

    message.textContent = en ? 'Loading departures…' : 'Pobieramy najbliższe odjazdy…';
    void refresh();
    window.setInterval(refresh, refreshMs);
    document.addEventListener('visibilitychange', refresh);
  }
</script>

<style>
  .board-wrap {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .board {
    overflow: hidden;
    background: var(--navy);
    border: 1px solid var(--line-dark);
    border-radius: 20px;
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.33);
    color: var(--white);
  }

  .board__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 24px;
    background: var(--navy-2);
  }

  .board__station {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .board__kind {
    font-size: 0.875rem;
    color: var(--mist);
  }

  .board__live {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .board__body {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .board__message {
    padding: 24px;
    color: var(--mist);
  }

  .board__row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto auto;
    gap: 12px;
    align-items: center;
    padding: 14px 24px;
  }

  .board__row + .board__row {
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  .board__time {
    display: grid;
    gap: 3px;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .board__time--late {
    color: var(--amber-bright);
  }

  .board__planned,
  .board__number,
  .board__platform,
  .board__pill {
    font-size: 0.75rem;
  }

  .board__planned,
  .board__number,
  .board__platform {
    color: var(--mist);
  }

  .board__train {
    display: grid;
    gap: 3px;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .board__direction {
    font-weight: 700;
    line-height: 1.25;
  }

  .board__pill {
    justify-self: end;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    color: var(--mist);
    font-weight: 700;
    white-space: nowrap;
  }

  .board__pill--ok { background: rgb(22 163 74 / 0.18); color: #86efac; }
  .board__pill--late { background: rgb(245 158 11 / 0.18); color: #fcd34d; }

  .board-caption {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding-inline: 4px;
    font-size: 0.8125rem;
    color: var(--mist);
  }

  .board-caption svg {
    flex: none;
    align-self: center;
  }

  [hidden] {
    display: none;
  }

  @media (max-width: 560px), (min-width: 1024px) and (max-width: 1250px) {
    .board__head,
    .board__row {
      padding: 14px 16px;
    }

    .board__station {
      font-size: 1rem;
    }

    .board__row {
      grid-template-columns: 50px minmax(0, 1fr) auto;
      grid-template-areas:
        'time train status'
        'time train platform';
      gap: 4px 10px;
    }

    .board__time { grid-area: time; font-size: 1.125rem; }
    .board__train { grid-area: train; }
    .board__direction { font-size: 0.9375rem; }
    .board__platform { grid-area: platform; justify-self: end; font-size: 0.6875rem; }
    .board__pill { grid-area: status; }
  }
</style>

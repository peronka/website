---
import { Image } from 'astro:assets';
import { Menu, X } from '@lucide/astro';
import icon from '../assets/brand/icon.png';
import StoreButton from './StoreButton.astro';
import { nav } from '../config';

interface Props {
  tone?: 'dark' | 'light';
}

const { tone = 'dark' } = Astro.props;
---

<header class:list={['nav', `nav--${tone}`]}>
  <div class="nav__inner">
    <a class="nav__logo" href="/" aria-label="Peronka — strona główna">
      <Image src={icon} alt="" width={36} height={36} densities={[1, 2]} loading="eager" class="nav__icon" />
      <span>Peronka</span>
    </a>

    <nav class="nav__links" aria-label="Główna nawigacja">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="nav__cta">
      <StoreButton size="small" tone={tone === 'dark' ? 'light' : 'dark'} />
    </div>

    <details class="nav__menu">
      <summary aria-label="Menu">
        <Menu size={26} class="nav__menu-open" aria-hidden="true" />
        <X size={26} class="nav__menu-close" aria-hidden="true" />
      </summary>
      <div class="nav__panel">
        {nav.map((item) => <a class="nav__panel-link" href={item.href}>{item.label}</a>)}
        <StoreButton tone="dark" />
      </div>
    </details>
  </div>
</header>

<style>
  .nav {
    position: relative;
    z-index: 10;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    max-width: calc(var(--wrap) + 2 * var(--gutter));
    height: 88px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .nav--dark .nav__inner {
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  .nav--light {
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .nav--light .nav__inner {
    height: 80px;
  }

  .nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav--dark .nav__logo {
    color: var(--white);
  }

  .nav__icon {
    width: 36px;
    height: 36px;
    border-radius: 9px;
  }

  .nav__links {
    display: flex;
    gap: 36px;
  }

  .nav__links a {
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-2);
    transition: color 0.15s;
  }

  .nav--dark .nav__links a {
    color: var(--mist);
  }

  .nav__links a:hover {
    color: var(--ink);
  }

  .nav--dark .nav__links a:hover {
    color: var(--white);
  }

  .nav__menu {
    display: none;
  }

  @media (max-width: 860px) {
    .nav__inner {
      height: 64px;
    }

    .nav__links,
    .nav__cta {
      display: none;
    }

    .nav__menu {
      display: block;
    }

    .nav__menu summary {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      list-style: none;
      cursor: pointer;
      color: var(--ink);
    }

    .nav--dark .nav__menu summary {
      color: var(--white);
    }

    .nav__menu summary::-webkit-details-marker {
      display: none;
    }

    .nav__menu-close,
    .nav__menu[open] .nav__menu-open {
      display: none;
    }

    .nav__menu[open] .nav__menu-close {
      display: block;
    }

    .nav__panel {
      position: absolute;
      top: 64px;
      left: 12px;
      right: 12px;
      display: grid;
      gap: 4px;
      padding: 12px;
      background: var(--white);
      border-radius: 16px;
      box-shadow: 0 24px 48px rgb(11 26 64 / 0.3);
    }

    .nav__panel-link {
      padding: 12px;
      font-weight: 600;
      color: var(--ink);
      text-decoration: none;
      border-radius: 10px;
    }

    .nav__panel-link:hover {
      background: var(--paper);
    }

    .nav__panel :global(.store) {
      margin-top: 8px;
      justify-self: start;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import { Smartphone, Lock, RefreshCw } from '@lucide/astro';
import lockScreen from '../../assets/widgets/lock-screen.png';
import WidgetSmall from '../widgets/WidgetSmall.astro';
import WidgetMedium from '../widgets/WidgetMedium.astro';
import WidgetLarge from '../widgets/WidgetLarge.astro';
import LiveActivity from '../widgets/LiveActivity.astro';

// Live HTML widgets, drawn after the ui.pen exports and driven by the same
// simulation as the hero board.
const widgets = [
  { component: WidgetSmall, name: 'Mały', desc: 'Najbliższy odjazd' },
  { component: WidgetMedium, name: 'Średni', desc: 'Trzy najbliższe odjazdy' },
  { component: WidgetLarge, name: 'Duży', desc: 'Tablica Twojej stacji' },
];

const laDetails = [
  { icon: Smartphone, title: 'Dynamic Island', text: 'iPhone 14 Pro i nowsze' },
  { icon: Lock, title: 'Ekran blokady', text: 'iOS 16.1 i nowsze' },
  { icon: RefreshCw, title: 'Na bieżąco', text: 'Peron i opóźnienie aktualizują się same' },
];
---

<section class="widgets dark" id="widzety">
  <div class="wrap widgets__inner">
    <header class="widgets__head">
      <p class="kicker mono">Widżety i Live Activity</p>
      <h2 class="widgets__title">Rozkład na ekranie głównym, pociąg na ekranie blokady</h2>
      <p class="lead">Sprawdzisz najbliższe odjazdy bez otwierania aplikacji — każdy widżet może pokazywać inną stację.</p>
    </header>

    <ul class="widgets__row">
      {
        widgets.map((w) => (
          <li class="widget">
            <w.component />
            <p class="widget__caption">
              <strong>{w.name}</strong>
              <span class="mono">{w.desc}</span>
            </p>
          </li>
        ))
      }
    </ul>

    <hr class="widgets__rule" />

    <div class="la">
      <Image
        src={lockScreen}
        alt="Ekran blokady iPhone'a z Live Activity śledzonego pociągu"
        width={360}
        densities={[1, 2]}
        class="la__lock"
      />
      <div class="la__text">
        <h3 class="la__title">Śledź pociąg bez odblokowywania telefonu</h3>
        <p class="la__body">
          Wybierz pociąg, a Live Activity pokaże go na ekranie blokady aż do stacji docelowej: postęp trasy, najbliższą
          stację, peron i każde opóźnienie.
        </p>
        <LiveActivity />
        <ul class="la__details">
          {
            laDetails.map((d) => (
              <li>
                <d.icon size={20} aria-hidden="true" />
                <strong>{d.title}</strong>
                <span class="mono">{d.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .widgets__inner {
    display: grid;
    gap: 88px;
    padding-top: var(--section);
    padding-bottom: var(--section);
  }

  .widgets__head {
    display: grid;
    gap: 20px;
    max-width: 760px;
  }

  .kicker {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--mist);
  }

  .widgets__title {
    font-size: var(--step-h2);
  }

  .widgets__row {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-end;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .widget {
    display: grid;
    justify-items: center;
    gap: 12px;
  }

  .widget__caption {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 0.9375rem;
  }

  .widget__caption span {
    font-size: 0.8125rem;
    color: var(--mist-2);
  }

  .widgets__rule {
    width: 100%;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--line-dark);
  }

  .la {
    display: grid;
    grid-template-columns: 360px 540px;
    gap: 96px;
    align-items: center;
    justify-content: center;
  }

  .la__text {
    display: grid;
    gap: 24px;
  }

  .la__title {
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.375rem);
    line-height: 1.1;
  }

  .la__body {
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--mist);
  }

  .la__details {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .la__details li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    padding: 14px 0;
    border-top: 1px solid var(--line-dark);
  }

  .la__details :global(svg) {
    color: var(--mist);
  }

  .la__details span {
    font-size: 0.8125rem;
    color: var(--mist-2);
  }

  @media (max-width: 1023px) {
    .widgets__inner {
      gap: 48px;
    }

    .la {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      justify-items: center;
    }

    .la__lock {
      width: min(300px, 80%);
    }

    .la__text {
      max-width: 540px;
    }
  }

  @media (max-width: 560px) {
    .widgets__row {
      gap: 24px;
    }

    .la__body {
      font-size: 1rem;
    }
  }
</style>

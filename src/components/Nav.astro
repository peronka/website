---
import { Image } from 'astro:assets';
import { Menu, X } from '@lucide/astro';
import icon from '../assets/brand/icon.png';
import StoreButton from './StoreButton.astro';
import { isEnglish, localizedPath, alternatePage } from '../lib/i18n';
import { nav } from '../config';

interface Props {
  tone?: 'dark' | 'light';
}

const { tone = 'dark' } = Astro.props;
const path = Astro.url.pathname;
const en = isEnglish(path);
const links = nav.map(item => ({ href: localizedPath(item.href, en), label: en ? item.english : item.label }));
---

<header class:list={['nav', `nav--${tone}`]}>
  <div class="nav__inner">
    <a class="nav__logo" href={localizedPath('/', en)} aria-label={en ? 'Peronka home' : 'Peronka — strona główna'}>
      <Image src={icon} alt="" width={36} height={36} densities={[1, 2]} loading="eager" class="nav__icon" />
      <span>Peronka</span>
    </a>

    <nav class="nav__links" aria-label={en ? 'Main navigation' : 'Główna nawigacja'}>
      {links.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="nav__cta">
      <StoreButton size="small" tone={tone === 'dark' ? 'light' : 'dark'} />
    </div>

    <details class="nav__menu">
      <summary aria-label="Menu">
        <Menu size={26} class="nav__menu-open" aria-hidden="true" />
        <X size={26} class="nav__menu-close" aria-hidden="true" />
      </summary>
      <div class="nav__panel">
        {links.map((item) => <a class="nav__panel-link" href={item.href}>{item.label}</a>)}
        <StoreButton tone="dark" />
      </div>
    </details>

    <nav class="languages" aria-label={en ? 'Website language' : 'Język strony'}>
      <a lang="pl" hreflang="pl" aria-label="Polski" aria-current={en ? undefined : 'true'} href={alternatePage(path, false)}>PL</a>
      <a lang="en" hreflang="en" aria-label="English" aria-current={en ? 'true' : undefined} href={alternatePage(path, true)}>EN</a>
    </nav>
  </div>
</header>

<script>
  // The home sections have the same anchors in both languages.
  function updateLanguageLinks() {
    const { pathname, hash } = window.location;
    if (pathname !== '/' && pathname !== '/en/') return;
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.languages a')) link.hash = hash;
  }
  updateLanguageLinks();
  window.addEventListener('hashchange', updateLanguageLinks);
</script>

<style>
  .nav {
    position: relative;
    z-index: 10;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    max-width: calc(var(--wrap) + 2 * var(--gutter));
    height: 88px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .nav--dark .nav__inner {
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  .nav--light {
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .nav--light .nav__inner {
    height: 80px;
  }

  .nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav--dark .nav__logo {
    color: var(--white);
  }

  .nav__icon {
    width: 36px;
    height: 36px;
    border-radius: 9px;
  }

  .nav__links {
    display: flex;
    gap: 36px;
  }

  .nav__links a {
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-2);
    transition: color 0.15s;
  }

  .nav--dark .nav__links a {
    color: var(--mist);
  }

  .nav__links a:hover {
    color: var(--ink);
  }

  .nav--dark .nav__links a:hover {
    color: var(--white);
  }

  .languages {
    display: inline-flex;
    flex-shrink: 0;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .languages a {
    display: grid;
    place-items: center;
    min-width: 38px;
    min-height: 32px;
    border-radius: 999px;
    color: var(--ink-2);
    font: 600 0.875rem var(--font-sans);
    text-decoration: none;
  }

  .languages a[aria-current] { background: var(--navy); color: var(--white); }
  .nav--dark .languages { border-color: rgb(255 255 255 / 0.3); }
  .nav--dark .languages a { color: var(--mist); }
  .nav--dark .languages a[aria-current] { background: var(--white); color: var(--night); }
  .languages a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .nav__menu {
    display: none;
  }

  @media (max-width: 860px) {
    .nav__inner {
      height: 64px;
      gap: 12px;
    }

    .nav__links,
    .nav__cta {
      display: none;
    }

    .nav__menu {
      margin-left: auto;
      display: block;
    }

    .nav__menu summary {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      list-style: none;
      cursor: pointer;
      color: var(--ink);
    }

    .nav--dark .nav__menu summary {
      color: var(--white);
    }

    .nav__menu summary::-webkit-details-marker {
      display: none;
    }

    .nav__menu-close,
    .nav__menu[open] .nav__menu-open {
      display: none;
    }

    .nav__menu[open] .nav__menu-close {
      display: block;
    }

    .nav__panel {
      position: absolute;
      top: 64px;
      left: 12px;
      right: 12px;
      display: grid;
      gap: 4px;
      padding: 12px;
      background: var(--white);
      border-radius: 16px;
      box-shadow: 0 24px 48px rgb(11 26 64 / 0.3);
    }

    .nav__panel-link {
      padding: 12px;
      font-weight: 600;
      color: var(--ink);
      text-decoration: none;
      border-radius: 10px;
    }

    .nav__panel-link:hover {
      background: var(--paper);
    }

    .nav__panel :global(.store) {
      margin-top: 8px;
      justify-self: start;
    }
  }
</style>

---
import { Download } from '@lucide/astro';
import { site } from '../config';
import { isEnglish } from '../lib/i18n';

const en = isEnglish(Astro.url.pathname);
---

<a class="apk" href={site.androidDownloadUrl}>
  <Download size={16} aria-hidden="true" />
  {en ? 'Download APK' : 'Pobierz APK'} · {site.androidVersion}
</a>

<style>
  .apk {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--mist);
    text-underline-offset: 3px;
  }
</style>

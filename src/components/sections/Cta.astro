---
import { Image } from 'astro:assets';
import { RESEND_API_KEY } from 'astro:env/server';
import icon from '../../assets/brand/icon.png';
import StoreButton from '../StoreButton.astro';
import NotifyForm from '../NotifyForm.astro';
import AndroidDownload from '../AndroidDownload.astro';
import { site } from '../../config';

---

<section class="cta wrap" id="pobierz">
  <div class="cta__band">
    <Image src={icon} alt="" width={104} height={104} densities={[1, 2]} class="cta__icon" />
    <div class="cta__text">
      <h2 class="cta__title">Sprawdź swój pociąg, zanim wyjdziesz z domu</h2>
      <p class="cta__meta mono">Bezpłatna · iPhone i Android · bez konta</p>
    </div>
    <div class="cta__stores">
      {site.appStoreUrl ? <StoreButton /> : <NotifyForm id="powiadom-cta" />}
      <AndroidDownload />
    </div>
    <section class="cta__tests" id="testy-android" aria-labelledby="testy-tytul">
      <div class="cta__text">
        <h2 id="testy-tytul">Zamknięte testy na Androidzie</h2>
        <p>Pomóż nam przetestować Peronkę przed publikacją w Google Play. Szukamy osób, które korzystają z telefonu z Androidem.</p>
      </div>
      <NotifyForm id="email-testera" androidTests useMailClient={!RESEND_API_KEY} />
    </section>
  </div>
</section>

<style>
  .cta {
    padding-bottom: var(--section);
  }

  .cta__band {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 48px;
    align-items: center;
    padding: 64px 72px;
    border-radius: 32px;
    background: linear-gradient(120deg, var(--navy-2) 0%, var(--navy) 60%, var(--night) 100%);
    color: var(--white);
  }

  .cta__icon {
    width: 104px;
    height: 104px;
    border-radius: 24px;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.15);
  }

  .cta__tests {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
    gap: 32px;
    align-items: start;
    border-top: 1px solid rgb(255 255 255 / .2);
    padding-top: 32px;
  }

  .cta__tests h2 { font-size: var(--step-h3); }
  .cta__tests p { color: var(--mist); }

  .cta__stores {
    display: grid;
    justify-items: start;
    gap: 14px;
  }

  .cta__text {
    display: grid;
    gap: 10px;
  }

  .cta__title {
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.5rem);
    line-height: 1.08;
  }

  .cta__meta {
    font-size: 0.875rem;
    color: var(--mist);
  }

  @media (max-width: 860px) {
    .cta__band {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
      gap: 20px;
      padding: 28px;
      border-radius: 24px;
    }

    .cta__tests { grid-template-columns: minmax(0, 1fr); gap: 20px; }

    .cta__icon {
      width: 64px;
      height: 64px;
      border-radius: 15px;
    }
  }
</style>
